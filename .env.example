# ====================================================================
# FOODS SAAS v2.0.0 — ARQUIVO DE CONFIGURAÇÃO DE AMBIENTE (.env)
# ====================================================================
# Instruções: Copie este arquivo para .env (cp .env.example .env) e preencha
# com as suas credenciais reais de produção.
# ====================================================================

# --------------------------------------------------------------------
# 1. SERVIDOR E APLICAÇÃO
# --------------------------------------------------------------------
PORT=3000
NODE_ENV=production
APP_URL="http://localhost:3000"

# --------------------------------------------------------------------
# 2. SUPABASE (POSTGRESQL DATABASE & AUTH)
# Como obter:
# 1. Acesse: https://supabase.com/dashboard e crie um projeto
# 2. Vá em Project Settings > API para copiar Project URL, anon key e service_role key
# 3. Vá em Project Settings > Database para copiar o Connection String (URI)
# --------------------------------------------------------------------
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-anon-public-key-aqui"
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-secret-key-aqui"
DATABASE_URL="postgresql://postgres:[SUA-SENHA]@db.[SEU-PROJETO].supabase.co:5432/postgres"

# --------------------------------------------------------------------
# 3. AUTENTICAÇÃO E JWT
# Chave secreta para assinatura dos tokens JWT internos
# --------------------------------------------------------------------
JWT_SECRET="foods-jwt-super-secret-key-producao-2026"

# --------------------------------------------------------------------
# 4. GOOGLE OAUTH 2.0 (LOGIN SOCIAL)
# Como obter:
# 1. Acesse: https://console.cloud.google.com/apis/credentials
# 2. Crie uma credencial OAuth 2.0 Client ID (Aplicação Web)
# 3. Adicione a URI de Redirecionamento autorizada do Supabase:
#    https://<seu-projeto>.supabase.co/auth/v1/callback
# --------------------------------------------------------------------
GOOGLE_CLIENT_ID="seu-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="seu-google-client-secret"

# --------------------------------------------------------------------
# 5. GATEWAYS DE PAGAMENTO
# --------------------------------------------------------------------

# A. MERCADO PAGO (PIX DINÂMICO & MAQUININHAS POINT PARA TOTEM / POS)
# Como obter:
# 1. Acesse: https://www.mercadopago.com.br/developers/panel
# 2. Copie Access Token e Public Key em Credenciais de Produção
MERCADOPAGO_ACCESS_TOKEN="APP_USR-seu-access-token-producao"
MERCADOPAGO_PUBLIC_KEY="APP_USR-sua-public-key-producao"

# B. INFINITYPAY (INFINITY HANDLE)
# Como obter: Acesse https://www.infinitepay.io/ e gere o Handle e API Key
INFINITYPAY_API_KEY=""
INFINITYPAY_HANDLE=""
INFINITYPAY_WEBHOOK_SECRET=""

# C. PAGSEGURO
PAGSEGURO_TOKEN=""
PAGSEGURO_EMAIL=""

# D. SYNCPAY
SYNCPAY_API_KEY=""
SYNCPAY_SECRET=""

# --------------------------------------------------------------------
# 6. WHATSAPP & REALTIME NOTIFICATIONS
# --------------------------------------------------------------------

# Meta Cloud API (Oficial):
# Como obter: https://developers.facebook.com/ > Meus Aplicativos > WhatsApp
META_WHATSAPP_TOKEN=""
META_WHATSAPP_PHONE_NUMBER_ID=""
META_WHATSAPP_BUSINESS_ACCOUNT_ID=""
META_WHATSAPP_VERIFY_TOKEN="foods_wa_verify_token_secure"

# Baileys WhatsApp (Conexão via QR Code Local):
BAILEYS_SESSION_PATH="./storage/whatsapp-sessions"

# --------------------------------------------------------------------
# 7. PRINTSCREENS E SCREENSHOTS DO SISTEMA PARA O README
# Insira aqui as URLs diretas dos arquivos .png / .jpg das telas do FoodS.
# Ao preencher aqui ou no README.md, as imagens serão renderizadas na
# documentação oficial.
# --------------------------------------------------------------------
SCREENSHOT_DASHBOARD_URL="https://raw.githubusercontent.com/foods-saas/assets/main/dashboard.png"
SCREENSHOT_ORDERS_KDS_URL="https://raw.githubusercontent.com/foods-saas/assets/main/kds-orders.png"
SCREENSHOT_POS_CAIXA_URL="https://raw.githubusercontent.com/foods-saas/assets/main/pos-caixa.png"
SCREENSHOT_TOTEM_URL="https://raw.githubusercontent.com/foods-saas/assets/main/totem.png"
SCREENSHOT_SETTINGS_URL="https://raw.githubusercontent.com/foods-saas/assets/main/settings.png"
SCREENSHOT_CARDAPIO_URL="https://raw.githubusercontent.com/foods-saas/assets/main/cardapio.png"
SCREENSHOT_ESTOQUE_URL="https://raw.githubusercontent.com/foods-saas/assets/main/estoque.png"
SCREENSHOT_GARCOM_MESAS_URL="https://raw.githubusercontent.com/foods-saas/assets/main/mesas.png"

# --------------------------------------------------------------------
# 8. IA & SERVIÇOS AUXILIARES
# --------------------------------------------------------------------
GEMINI_API_KEY=""

